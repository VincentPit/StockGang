{
  "uid": "myquant-trading",
  "title": "MyQuant — Trading",
  "tags": ["myquant"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders (per minute, by side & mode)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (action, mode) (rate(myquant_broker_orders_total[5m])) * 60",
          "legendFormat": "{{action}} ({{mode}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Order failures (last 1h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (mode) (increase(myquant_broker_order_failures_total[1h]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Buys vs Sells (cumulative)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (action) (myquant_broker_orders_total)",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    }
  ]
}
